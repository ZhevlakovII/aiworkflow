# Claude Code local state (consumer root and port-source copy if present)
.claude/settings.local.json
ports/claude/settings.local.json

# IDE
.idea/
*.iml

# OS
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]

# Workflow runtime state — ignore contents, but track tasks + stage journals
# (Design C AD-workflow-versioning: tracked .workflow/tasks + .workflow/stages)
/.workflow/*
!/.workflow/tasks/
!/.workflow/tasks/**
!/.workflow/stages/
!/.workflow/stages/**
# Nested clones / core test runs also emit telemetry under core/.workflow
core/.workflow/

# Probe/test artifacts
iso-proof*.txt
/AIWorkflow/            # артефакт isolated-merge (nested repo-name dir), не должен существовать

# Dev-only каталоги (не в public dist)
/sandbox/
/reports/

# Target-полигон (FinManageApp — вложенный репо со своим git, не версионим в AIWorkflow)
test-project/

# DSH project overlay (installer stamps from ports/dsh; not SRC)
.dsh-aiwf/
