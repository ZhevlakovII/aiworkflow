# OMP custom providers — MACHINE-SPECIFIC template (bootstrap seeds this when ~/.omp/agent/models.yml absent).
# NOT product/git canon: edit endpoint + contextWindow for your machine, then it is yours.
# Schema: docs/models.md. LM Studio discovery is built-in; explicit provider+model = stable cost/context.
#
# maxSubagents (task-3): сколько задач очередь (queue-runner) гонит ПАРАЛЛЕЛЬНО на эту модель.
#   Ставь по РЕАЛЬНОЙ ёмкости провайдера: локальный LM Studio/Qwen тянет 1 (один GPU-слот),
#   удалённый API (deepseek/strong) — больше. Дефолт для незаданных моделей — defaults.maxSubagents.
#   Читается _lib/modelcaps.ts; вне очереди (интерактив) не ограничивает.
defaults:
  maxSubagents: 1                        # глобальный дефолт-потолок параллелизма на модель
providers:
  lm-studio:
    baseUrl: http://localhost:1234/v1   # EDIT: your LM Studio endpoint (host:port)
    api: openai-completions
    auth: none
    discovery:
      type: lm-studio
    models:
      - id: qwen/qwen3.6-35b-a3b         # EDIT: the model id loaded in LM Studio
        name: Qwen3.6 35B A3B (local LM Studio)
        api: openai-completions
        reasoning: false                 # flip → true if the model emits <think> and you want reasoning-effort
        input: [text]
        tokenizer: qwen3
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }   # local = free (Pool B)
        contextWindow: 131072            # EDIT: match the context loaded in LM Studio
        maxTokens: 16384
        maxSubagents: 1                  # local single-slot → очередь не параллелит эту модель
  # Пример удалённого провайдера с бОльшим параллелизмом (раскомментируй/поправь под свой ключ):
  # deepseek:
  #   baseUrl: https://api.deepseek.com/v1
  #   api: openai-completions
  #   auth: { type: bearer, key: env:DEEPSEEK_API_KEY }
  #   models:
  #     - id: deepseek-chat
  #       name: DeepSeek Chat
  #       api: openai-completions
  #       maxSubagents: 4                # remote API держит больше параллельных запросов
