# MACHINE-HEAD template — bootstrap seeds this as the head of ~/.omp/agent/config.yml when no
# modelRoles: block exists yet. NOT product/git canon (installer PRESERVES it, never overwrites).
# Seed defaults: xAI Composer as temporary cheap/default tier (NOT local Qwen as lead-default).
# producer/slow/scaffolder = grok-4.7; other native roles = grok-composer-2.5-fast.
# Strong routing by class/blast-radius uses fan-out/critic/slow via native modelRoles and session tools.
# These are seed defaults only; setup runs tools/setup_roles.ts to (re)bind each role from your
# REAL models.yml (interactive) and to warn about unset/unknown roles. EDIT here or let the binder do it.
# Local LM Studio + Qwen remains optional via models.yml.example — not the role seed default.
modelRoles:
  default:  xai-oauth/grok-composer-2.5-fast
  smol:     xai-oauth/grok-composer-2.5-fast
  slow:     xai-oauth/grok-4.7
  producer: xai-oauth/grok-4.7
  scaffolder: xai-oauth/grok-4.7
  critic:   xai-oauth/grok-composer-2.5-fast
  explorer: xai-oauth/grok-composer-2.5-fast
  advisor:  xai-oauth/grok-composer-2.5-fast
theme:
